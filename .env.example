# Neon — https://console.neon.tech
DATABASE_URL=postgresql://...

# X API — https://console.x.com  (buy credits; owned reads are $0.001/resource)
X_CLIENT_ID=
X_CLIENT_SECRET=
# printed by `npm run x:auth`
X_USER_ID=

# xAI — https://console.x.ai  (up to 20% back when you buy X API credits)
XAI_API_KEY=

# Resend — https://resend.com
RESEND_API_KEY=
NEWSLETTER_FROM="Jeremy Dudet <hello@jeremydudet.com>"

# Vercel Blob (media rehosting) — auto-set on Vercel, needed for local runs
BLOB_READ_WRITE_TOKEN=

# Anything long and random: `openssl rand -base64 32`
CRON_SECRET=
ADMIN_PASSWORD=

# ── LinkedIn (cross-posting) ───────────────────────────────────────────
# developer.linkedin.com → your app → Products tab:
#   + "Share on LinkedIn"  (grants w_member_social)
#   + "Sign In with LinkedIn using OpenID Connect"
# Auth tab → Authorized redirect URL: http://localhost:8788/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Leave unset to review each cross-post in /admin first.
# Set to true only once you trust the rubric — posts go out unattended.
LINKEDIN_AUTO_POST=
# Only cross-post posts newer than this (YYYY-MM-DD).
SYNDICATE_AFTER=

# ── Social output ──────────────────────────────────────────────────────
# Single publish target. "x" posts directly; a scheduling provider
# (Buffer/Typefully/MCP) slots in here later to fan out across networks.
SOCIAL_PROVIDER=x
# Re-enable the separate LinkedIn rubric + queue. Off: cross-post by hand.
CROSSPOST_LINKEDIN=

# ── Email transport ────────────────────────────────────────────────────
# resend | ses | console   (console prints instead of sending)
EMAIL_PROVIDER=console
# ses only:
AWS_REGION=us-east-2

# Late (getlate.dev) — cross-posts X + LinkedIn personal profile.
# Set SOCIAL_PROVIDER=late once accounts are connected.
LATE_API_KEY=
# platform:accountId pairs, e.g. twitter:acc_abc,linkedin:acc_def
LATE_ACCOUNTS=

# ── App auth ───────────────────────────────────────────────────────────
# 6 digits, typed on the login keypad.
ADMIN_PASSCODE=
# Bearer token for the iOS Shortcut. Write-only: creates entries, cannot
# read the journal or reach /admin. See docs/shortcut.md
JOURNAL_API_TOKEN=

# ── Voice transcription ────────────────────────────────────────────────
# groq (default, ~$0.0006/min, 2000 req/day free) | openai
TRANSCRIBE_PROVIDER=groq
# console.groq.com → API key. Without this the mic button is hidden.
GROQ_API_KEY=
